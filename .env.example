# YolUp CRM — Frontend environment variables
# Copy to .env and fill in values. Never commit .env.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Application name / brand
VITE_APP_NAME=YolUp CRM
VITE_APP_VERSION=1.0.0

# Default tenant (educational center) slug used before login / tenant switch
VITE_DEFAULT_TENANT_SLUG=

# Enable React Query devtools in development (strip in production)
VITE_ENABLE_QUERY_DEVTOOLS=true

# Use the built-in mock API instead of a real backend (default: true).
# Set to false once the Django backend is reachable.
VITE_USE_MOCK_API=true

# Sentry DSN (optional)
VITE_SENTRY_DSN=
